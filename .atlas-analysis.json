  "keyFeatures": [
    "Financial dashboard with income, expense and balance overview",
    "Transaction management with create, edit, and delete support",
    "Category management for organizing transactions",
    "Interactive charts powered by ECharts for spending analysis",
    "Filtering by year, month, category, and transaction type",
    "Dark mode support with system preference detection",
    "Persistent user session via localStorage",
    "Responsive design built with Tailwind CSS"
  ],
  "publicApiSurface": [
    "GET /api/transactions",
    "POST /api/transactions",
    "PATCH /api/transactions/:id",
    "DELETE /api/transactions/:id",
    "GET /api/transactions/years",
    "GET /api/categories",
    "POST /api/categories",
    "PUT /api/categories/:id",
    "DELETE /api/categories/:id",
    "GET /api/stats/monthly",
    "GET /api/stats/top-categories",
    "GET /api/stats/by-category"
  ]
